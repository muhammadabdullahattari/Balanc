# Local development only. Replace values only in your ignored .env file.
APP_ENV=local
APP_NAME=LedgerPilot API
API_V1_PREFIX=/api/v1
POSTGRES_DB=ledgerpilot
POSTGRES_USER=ledgerpilot
POSTGRES_PASSWORD=replace-with-a-url-safe-random-local-password
DATABASE_URL=postgresql+psycopg://ledgerpilot:replace-with-a-url-safe-random-local-password@localhost:5432/ledgerpilot
SESSION_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-bytes
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
