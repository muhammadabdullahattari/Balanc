# Local development only. Replace values only in your ignored .env file.
APP_ENV=local
APP_NAME=LedgerPilot API
API_V1_PREFIX=/api/v1
POSTGRES_DB=ledgerpilot
POSTGRES_PORT=5432
POSTGRES_USER=ledgerpilot
POSTGRES_PASSWORD=replace-with-a-url-safe-random-local-password
APP_DB_USER=ledgerpilot_app
APP_DB_PASSWORD=replace-with-a-different-url-safe-random-local-password
MIGRATION_DB_USER=ledgerpilot_migrator
MIGRATION_DB_PASSWORD=replace-with-another-url-safe-random-local-password
DATABASE_URL=postgresql+psycopg://ledgerpilot_app:replace-with-a-different-url-safe-random-local-password@localhost:5432/ledgerpilot
MIGRATION_DATABASE_URL=postgresql+psycopg://ledgerpilot_migrator:replace-with-another-url-safe-random-local-password@localhost:5432/ledgerpilot
SESSION_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-bytes
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Bounded per-process pool budget, consumed by the Phase 2 DB session factory.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
# Phase 2 identity. Generated locally by the setup helper; never expose to the browser.
MFA_ENCRYPTION_KEY=
MFA_KEY_INITIALIZED=false
JWT_ISSUER=ledgerpilot
JWT_AUDIENCE=ledgerpilot-web
JWT_KEY_ID=v1
COOKIE_SAMESITE=lax
AUTH_DELIVERY_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=accounts@ledgerpilot.local
SMTP_STARTTLS=false

# Optional, temporary JWT signing-key rollover; keep old access tokens valid for at most 10 minutes.
# SESSION_PREVIOUS_SIGNING_KEY=
# SESSION_PREVIOUS_KEY_ID=

# Phase 3: private local evidence (never expose encryption keys in the browser).
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_KEY_INITIALIZED=false
# Optional path override: EVIDENCE_STORAGE_ROOT=...
EVIDENCE_MAX_BYTES=26214400
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
EXPORT_SIGNING_PRIVATE_KEY=
EXPORT_KEY_INITIALIZED=false
OCR_ENABLED=false
OCR_SERVICE_URL=http://127.0.0.1:8071/extract
OCR_SERVICE_TOKEN=
RATE_DB_POOL_SIZE=2
