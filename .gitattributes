# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit LF for scripts and configurations
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.tar binary
*.gz binary
