FROM ghcr.io/astral-sh/uv:0.12.7 AS uv
FROM python:3.12-slim AS ocr
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy OMP_THREAD_LIMIT=1
WORKDIR /app
RUN apt-get update && apt-get install --no-install-recommends -y tesseract-ocr tesseract-ocr-eng poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /bin/uv
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY src ./src
RUN uv sync --locked --no-dev && useradd --uid 10001 --create-home appuser
USER appuser
EXPOSE 8071
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8071/health', timeout=3)"
CMD ["/app/.venv/bin/uvicorn", "ledgerpilot.documents.ocr_service:app", "--host", "0.0.0.0", "--port", "8071", "--no-access-log"]
