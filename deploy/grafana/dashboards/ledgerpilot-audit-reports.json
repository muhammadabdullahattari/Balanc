        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^runs_checked$/", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ledgerpilot-postgres-ro" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*)::integer AS runs_checked FROM app.grafana_audit_series('$business_id'::uuid, $__timeFrom()::date, $__timeTo()::date, '$audit_type');",
          "refId": "A"
        }
      ],
      "title": "Audits Completed in Period",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "ledgerpilot-postgres-ro" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "noValue": "No audit findings for this period"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Critical" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#b3353e", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "High" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#b86b2b", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Medium" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#4c638a", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Low" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#1f7a5c", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "barWidth": 0.65,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "vertical",
        "showValue": "always",
        "xField": "severity_level"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ledgerpilot-postgres-ro" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT * FROM app.grafana_audit_series('$business_id'::uuid, $__timeFrom()::date, $__timeTo()::date, '$audit_type') ORDER BY run_time DESC LIMIT 1) SELECT 'Critical' AS severity_level, coalesce((SELECT critical_count FROM latest), 0) AS findings UNION ALL SELECT 'High', coalesce((SELECT high_count FROM latest), 0) UNION ALL SELECT 'Medium', coalesce((SELECT medium_count FROM latest), 0) UNION ALL SELECT 'Low', coalesce((SELECT low_count FROM latest), 0);",
          "refId": "A"
        }
      ],
      "title": "Audit Findings by Severity",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "ledgerpilot-postgres-ro" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#274b7a", "mode": "fixed" },
          "decimals": 0,
          "min": 0,
          "noValue": "No audit findings for this period"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "barWidth": 0.68,
        "legend": { "displayMode": "hidden", "placement": "bottom", "showLegend": false },
        "orientation": "horizontal",
        "showValue": "always",
        "xField": "category"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ledgerpilot-postgres-ro" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_run AS (SELECT findings FROM app.financial_audit_runs WHERE business_id = '$business_id'::uuid AND period_end >= $__timeFrom()::date AND period_start <= $__timeTo()::date AND ('$audit_type' = 'all' OR audit_type = '$audit_type') ORDER BY created_at DESC LIMIT 1) SELECT coalesce(f->>'category', 'general') AS category, count(*)::integer AS issue_count FROM latest_run, jsonb_array_elements(latest_run.findings) AS f GROUP BY 1 ORDER BY 2 DESC;",
          "refId": "A"
        }
      ],
      "title": "Audit Findings by Category",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "ledgerpilot-postgres-ro" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 85 },
          "decimals": 0,
          "min": 0,
          "noValue": "No audit history in this period"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "critical_count" },
            "properties": [
              { "id": "displayName", "value": "Critical" },
              { "id": "color", "value": { "fixedColor": "#b3353e", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "high_count" },
            "properties": [
              { "id": "displayName", "value": "High" },
              { "id": "color", "value": { "fixedColor": "#b86b2b", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "medium_count" },
            "properties": [
              { "id": "displayName", "value": "Medium" },
              { "id": "color", "value": { "fixedColor": "#4c638a", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "low_count" },
            "properties": [
              { "id": "displayName", "value": "Low" },
              { "id": "color", "value": { "fixedColor": "#1f7a5c", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ledgerpilot-postgres-ro" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT run_time AS \"time\", critical_count, high_count, medium_count, low_count FROM app.grafana_audit_series('$business_id'::uuid, $__timeFrom()::date, $__timeTo()::date, '$audit_type');",
          "refId": "A"
        }
      ],
      "title": "Audit Issues Over Time ($audit_type)",
      "type": "timeseries"
    }
