{
  "name": "ledgerpilot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../docs/contracts/openapi.json -o src/api/generated/schema.ts",
    "api:check": "openapi-typescript ../docs/contracts/openapi.json -o src/api/generated/schema.ts --check",
    "test:api": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler tests/api-contract.test.ts && node --test tests/api-client.test.mjs",
    "test:ui": "vitest run",
    "format:check": "prettier --check src/App.tsx src/components src/features src/styles.css src/api/runtime.ts",
    "test:live": "node tests/run-live.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "axe-core": "^4.14.0",
    "fetch-cookie": "^3.2.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tough-cookie": "^6.0.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
